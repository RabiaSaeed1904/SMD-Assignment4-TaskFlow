<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Project Name *"
            android:textColor="#202C40"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDialogProjectName"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_search_field"
            android:hint="1-60 characters"
            android:maxLength="60"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Project Tag *"
            android:textColor="#202C40"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDialogProjectTag"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_search_field"
            android:hint="1-20 characters"
            android:maxLength="20"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Project Description *"
            android:textColor="#202C40"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDialogProjectDesc"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_search_field"
            android:gravity="top"
            android:hint="1-500 characters"
            android:maxLength="500"
            android:padding="12dp"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Optional Attachment"
            android:textColor="#202C40"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnDialogAttachment"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="#202C40"
            android:minHeight="0dp"
            android:text="+ Select from Catalog"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvDialogAttachmentSelected"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="No attachment selected"
            android:textColor="#91A1BB"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>