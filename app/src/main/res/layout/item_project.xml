<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_workspace_card"
    android:elevation="2dp"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvProjectTag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#E8EAED"
        android:paddingStart="8dp"
        android:paddingTop="2dp"
        android:paddingEnd="8dp"
        android:paddingBottom="2dp"
        android:text="Tag"
        android:textColor="#5F6368"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvProjectName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Project Name"
        android:textColor="#202C40"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvProjectDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Project description goes here..."
        android:textColor="#91A1BB"
        android:textSize="12sp" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <TextView
            android:id="@+id/tvProjectTaskProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:drawableStart="@android:drawable/ic_menu_agenda"
            android:drawablePadding="4dp"
            android:text="0/0 tasks"
            android:textColor="#91A1BB"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvProjectPercentage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="0%"
            android:textColor="#91A1BB"
            android:textSize="11sp" />
    </RelativeLayout>

    <ProgressBar
        android:id="@+id/pbProjectProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/bg_progress_bar" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="#E8EAED" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvProjectAttachmentsCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:drawableStart="@android:drawable/ic_menu_gallery"
            android:drawablePadding="4dp"
            android:text="0 Attachments"
            android:textColor="#91A1BB"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvProjectCommentsCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableStart="@android:drawable/ic_menu_sort_by_size"
            android:drawablePadding="4dp"
            android:text="0 Comments"
            android:textColor="#91A1BB"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>