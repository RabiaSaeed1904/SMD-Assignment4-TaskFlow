<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FA"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="24dp"
    android:paddingEnd="16dp">

    <!-- WELCOME SECTION -->
    <TextView
        android:id="@+id/tvWelcome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:text="Hi, Rabia"
        android:textColor="#172033"
        android:textSize="21sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvWelcomeSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:paddingStart="4dp"
        android:text="Are you ready to get back to work?"
        android:textColor="#91A1BB"
        android:textSize="12sp" />

    <!-- WORKSPACE CARD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_workspace_card"
        android:elevation="2dp"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Workspace"
                    android:textColor="#91A1BB"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Sports App"
                    android:textColor="#172033"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvWorkspaceCreated"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Created: 20 May 2022"
                    android:textColor="#91A1BB"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvWorkspaceArrow"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_workspace_arrow"
                android:gravity="center"
                android:text="↗"
                android:textColor="#3099F3"
                android:textSize="20sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnNewProject"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#3099F3"
            android:elevation="1dp"
            android:minHeight="0dp"
            android:text="+ New Project"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- SEARCH INPUT -->
    <EditText
        android:id="@+id/etSearchProjects"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_search_field"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:drawablePadding="10dp"
        android:hint="Search projects..."
        android:inputType="text"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:textColor="#172033"
        android:textColorHint="#91A1BB"
        android:textSize="13sp" />

    <!-- PROJECT COUNT LABEL -->
    <TextView
        android:id="@+id/tvProjectsCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:text="Showing 5 projects"
        android:textColor="#91A1BB"
        android:textSize="11sp" />

    <!-- BUILT-IN LISTVIEW -->
    <ListView
        android:id="@+id/lvProjects"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="12dp"
        android:overScrollMode="never"
        android:scrollbars="vertical" />

    <!-- EMPTY STATE -->
    <TextView
        android:id="@+id/tvNoProjects"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:text="No matching projects found."
        android:textColor="#91A1BB"
        android:textSize="13sp"
        android:visibility="gone" />

</LinearLayout>