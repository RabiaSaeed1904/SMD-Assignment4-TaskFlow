<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FA"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="28dp"
        android:paddingEnd="16dp"
        android:paddingBottom="40dp">

        <!-- WELCOME -->

        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:text="Hi, Rabia"
            android:textColor="#172033"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvWelcomeSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:paddingStart="4dp"
            android:text="Are you ready to get back to work?"
            android:textColor="#91A1BB"
            android:textSize="12sp" />

        <!-- WORKSPACE CARD -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_workspace_card"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvWorkspaceLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Workspace"
                        android:textColor="#91A1BB"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvWorkspaceName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Sports App"
                        android:textColor="#172033"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvWorkspaceCreated"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Created :"
                        android:textColor="#91A1BB"
                        android:textSize="12sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvWorkspaceArrow"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_workspace_arrow"
                    android:contentDescription="Workspace"
                    android:gravity="center"
                    android:text="↗"
                    android:textColor="#3099F3"
                    android:textSize="24sp" />

            </LinearLayout>


            <Button
                android:id="@+id/btnNewProject"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="#3099F3"
                android:elevation="2dp"
                android:minHeight="0dp"
                android:text="+  New Project"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- PROJECT SEARCH -->

        <EditText
            android:id="@+id/etSearchProjects"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_search_field"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="12dp"
            android:hint="Search projects..."
            android:inputType="text"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:textColor="#172033"
            android:textColorHint="#91A1BB"
            android:textSize="12sp" />

        <!-- PROJECT COUNT -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvProjectsShowingLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Showing "
                android:textColor="#91A1BB"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvUpcomingCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#91A1BB"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" projects"
                android:textColor="#91A1BB"
                android:textSize="11sp" />


            <Button
                android:id="@+id/btndeleteproject"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="#3099F3"
                android:elevation="2dp"
                android:minHeight="0dp"
                android:text="DeleteProject"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- DYNAMIC PROJECT CARDS -->

        <LinearLayout
            android:id="@+id/llUpcomingProjects"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical" />

        <!-- EMPTY STATE -->

        <TextView
            android:id="@+id/tvNoProjects"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="No projects yet. Create your first project!"
            android:textColor="#91A1BB"
            android:textSize="13sp"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>
