<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_workspace_card"
    android:elevation="1dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <TextView
        android:id="@+id/tvAttachmentIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="#EAF3F4"
        android:gravity="center"
        android:text="📄"
        android:textSize="20sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvAttachmentName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="sports-projectv2.fig"
            android:textColor="#202C40"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAttachmentMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Image • 2.4 MB"
            android:textColor="#91A1BB"
            android:textSize="11sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnAttachmentPreview"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:backgroundTint="#F1F3F6"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:text="Preview"
        android:textAllCaps="false"
        android:textColor="#202C40"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/btnAttachmentRemove"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="8dp"
        android:gravity="center"
        android:text="🗑"
        android:textColor="#E67C7C"
        android:textSize="16sp" />

</LinearLayout>