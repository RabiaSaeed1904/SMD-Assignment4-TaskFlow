<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FA"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp">

    <!-- SEARCH -->
    <EditText
        android:id="@+id/etSearchFiles"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="@drawable/bg_search_field"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:drawablePadding="10dp"
        android:hint="Search attachments by display name..."
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:textColor="#202C40"
        android:textSize="12sp" />

    <!-- FILTER CHIPS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chipAll"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_workspace_card"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="All (3)"
            android:textColor="#3099F3"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chipImages"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_workspace_card"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Images (2)"
            android:textColor="#58677D"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/chipText"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_workspace_card"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Text (1)"
            android:textColor="#58677D"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvFilesCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Showing 3 of 3 attachments"
        android:textColor="#91A1BB"
        android:textSize="11sp" />

    <!-- BUILT-IN LISTVIEW -->
    <ListView
        android:id="@+id/lvAttachments"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="10dp"
        android:overScrollMode="never"
        android:scrollbars="vertical" />

    <!-- EMPTY STATE -->
    <LinearLayout
        android:id="@+id/layoutFilesEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvFilesEmptyMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No attachments yet"
            android:textColor="#91A1BB"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnFilesEmptyAction"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#3099F3"
            android:text="+ Add Attachment"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- ADD ATTACHMENT BUTTON -->
    <Button
        android:id="@+id/btnFilesAdd"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#3099F3"
        android:text="+ Add Attachment"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>